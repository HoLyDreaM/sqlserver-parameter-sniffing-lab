# SQL Server SA password (required). Copy to .env — do not commit .env.
# UYARI: örnek şifreyi laboratuvar dışında kullanmayın; .env içinde kendi güçlü şifrenizi yazın.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# Edition: Developer | Express | Standard | Enterprise (lab default: Developer)
MSSQL_PID=Developer

# Host port published on 127.0.0.1 only (container listens on 1433).
# Yerel SQL (1433) veya başka bir lab ile çakışırsa bu değeri değiştirin.
MSSQL_HOST_PORT=14335
